# Ne jamais committer de secrets — ce fichier ne contient que des exemples.

# Valeurs prêtes pour la stack `npm run dev:up`.
DATABASE_URL=postgresql://ace:ace@localhost:5432/ace_dev
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=ace
S3_SECRET_KEY=ace-secret-local
S3_BUCKET=ace-assets
S3_REGION=us-east-1

# Secret de signature des URL d'actifs. À régénérer pour chaque
# environnement : openssl rand -hex 32
ASSET_URL_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Activation des moteurs. Hunyuan reste faux tant que sa licence et le
# territoire d'exploitation n'ont pas été validés juridiquement (docs/models.md).
LTX_ENABLED=true
WAN_ENABLED=true
HUNYUAN_ENABLED=false

LTX_MODEL_PATH=
WAN_MODEL_PATH=
HUNYUAN_MODEL_PATH=

OPENAI_API_KEY=

# mock en développement, router en production
VIDEO_PROVIDER=mock

APP_URL=http://localhost:3000

# Moteur LTX. Les deux drapeaux sont distincts à dessein : activer le moteur
# ne suffit pas, il faut aussi attester que sa licence a été vérifiée.
LTX_ENDPOINT=
LTX_COMMERCIAL_VERIFIED=false

# Moteur hébergé fal.ai — aucune infrastructure, facturé à la seconde produite.
# C'est le moteur de lancement, avant qu'un GPU propre ne devienne rentable.
FAL_KEY=

PORT=3001
CORS_ORIGIN=
MAX_CONCURRENT_GENERATIONS=2

# Interface web (apps/web). Elle parle à l'API par chemin relatif /v1,
# donc aucune URL n'est codée en dur.
WEB_PORT=3000
